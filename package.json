{
  "name": "shopping-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --configLoader runner\" \"node --env-file-if-exists=.env server.mjs\"",
    "api": "node --env-file-if-exists=.env server.mjs",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "node --test tests/*.test.mjs",
    "resolver:test": "node --env-file-if-exists=.env resolver-test.mjs",
    "resolver:test-suite": "node --env-file-if-exists=.env resolver-test-suite.mjs",
    "resolver:clear-test-data": "node resolver-clear-test-data.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "playwright": "^1.63.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
